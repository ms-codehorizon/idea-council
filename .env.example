# Anthropic (required - used as synthesizer and debater)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5

# Ollama (local - no key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODELS=qwen2.5:7b,llama3.1:8b,mistral:7b

# Optional cloud providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Market verification
GITHUB_SEARCH_ENABLED=true
GITHUB_SEARCH_MAX_RESULTS=10

# Tavily web search (optional - skipped if not set)
TAVILY_API_KEY=

# Session
MAX_TOKENS_PER_CALL=2048
OUTPUT_DIR=output
LOG_LEVEL=INFO
